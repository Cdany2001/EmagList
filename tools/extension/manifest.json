{
  "manifest_version": 3,
  "name": "BF List vs eMag -- price reader",
  "version": "1.0",
  "description": "Lets the BF List page read eMag prices from your own browser, with no proxy in between.",
  "host_permissions": ["https://*.emag.ro/*"],
  "background": { "service_worker": "reader.js" },
  "content_scripts": [
    {
      "matches": [
        "https://cdany2001.github.io/EmagList/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
